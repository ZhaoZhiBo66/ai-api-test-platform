OPENAI_API_KEY=sk-your-key
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2

# 本地默认使用项目根目录的 SQLite；需要 MySQL 时替换这一行。
DATABASE_URL=sqlite:///./ai_test_platform.db

# Production/container deployments must set both values. Keep auth disabled
# only for local development where the service is not exposed.
API_AUTH_ENABLED=false
PLATFORM_API_KEY=replace-with-a-long-random-secret
# 用于加密环境 secrets；生产环境必须独立配置且不可随意更换。
PLATFORM_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
# 可选：多角色API Key。viewer只读、operator可执行、admin可删除和查看审计日志。
# PLATFORM_API_KEYS={"viewer-secret":"viewer","operator-secret":"operator","admin-secret":"admin"}

# 以下四项仅供 docker compose 创建 MySQL 和拼装容器内 DATABASE_URL。
MYSQL_ROOT_PASSWORD=replace-with-a-separate-root-password
DB_USER=ai_test_app
DB_PASSWORD=replace-with-an-app-database-password
DB_NAME=ai_test_platform

# 被测系统的数据库，仅 SQL 数据校验用到。留空则跳过 SQL 校验并给出提示。
# 不要指向上面的平台库：那里只有平台自己的元数据表。
SUT_DATABASE_URL=
# 可选：限制SQL校验可访问的表，逗号分隔；生产环境建议配置。
SUT_ALLOWED_TABLES=

# 默认拒绝内网目标。内网测试环境可显式开启或只加入指定主机白名单。
ALLOW_PRIVATE_TARGETS=false
TARGET_HOST_ALLOWLIST=

# 内置订单演示服务地址；scripts/run_demo.py 会自动配置本地值。
DEMO_SUT_URL=http://127.0.0.1:8010

ASYNC_WORKERS=4
MAX_QUEUED_RUNS=100

BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

